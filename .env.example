# [50] .env.example  (copie para .env e preencha)

# Porta do servidor (local)
PORT=3000

# String de conexão do MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/monitoramento_amazonia?retryWrites=true&w=majority

API_KEY=troque-por-uma-chave-longa-e-secreta
# Origens permitidas no CORS (separadas por virgula). Dev: Angular na 4200
CORS_ORIGIN=http://localhost:4200,http://localhost:8080

# true = a API coleta sozinha (node-cron). No Google Cloud usa-se o Cloud Scheduler
AGENDAR=true
